{
    "name": "neojoin",
    "displayName": "NeoJoin",
    "description": "Language support and live visualization for NeoJoin queries",
    "author": "Tobias Stickling",
    "contributors": [
        {
            "name": "larsk21",
            "url": "https://github.com/larsk21"
        }
    ],
    "license": "EPL-2.0",
    "version": "0.1.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/vitruv-tools/NeoJoin-for-VS-Code"
    },
    "bugs": {
        "url": "https://github.com/vitruv-tools/NeoJoin-for-VS-Code/issues"
    },
    "homepage": "https://github.com/vitruv-tools/NeoJoin-for-VS-Code#readme",
    "publisher": "vitruv-tools",
    "engines": {
        "vscode": "^1.91.0"
    },
    "activationEvents": [
        "onWebviewPanel:neojoin.visualization"
    ],
    "main": "./dist/extension",
    "contributes": {
        "languages": [
            {
                "id": "neojoin",
                "aliases": [
                    "NeoJoin"
                ],
                "extensions": [
                    ".nj"
                ],
                "configuration": "./src/language/configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "neojoin",
                "scopeName": "source.neojoin",
                "path": "./src/language/neojoin.tmGrammar.json"
            }
        ],
        "commands": [
            {
                "command": "neojoin.restart",
                "title": "Restart Server",
                "category": "NeoJoin"
            },
            {
                "command": "neojoin.visualization",
                "title": "Show Query Visualization",
                "category": "NeoJoin",
                "icon": {
                    "light": "./resources/icons/preview.svg",
                    "dark": "./resources/icons/preview-inverse.svg"
                }
            },
            {
                "command": "neojoin.generate-viewtype",
                "title": "Generate View Type",
                "category": "NeoJoin"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "neojoin.visualization",
                    "when": "editorLangId == neojoin",
                    "group": "z_commands@99"
                }
            ],
            "editor/title": [
                {
                    "command": "neojoin.visualization",
                    "when": "editorLangId == neojoin",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "NeoJoin",
            "properties": {
                "neojoin.metaModelSearchPath": {
                    "type": "string",
                    "scope": "machine-overridable",
                    "default": "${workspaceFolder}",
                    "markdownDescription": "List of search paths for meta models (*.ecore files) separated by semicolons. Found models can be imported in NeoJoin queries.\n\nExample: `/path/to/directory;/path/to/model.ecore;C:/path/to/archive.jar`\n\n**Note:** Changes to the files on disk require a restart of the language server (**NeoJoin: Restart Server**)."
                },
                "neojoin.excludedDirectories": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "scope": "machine-overridable",
                    "default": [
                        "target",
                        "bin",
                        "build",
                        "node_modules",
                        ".git"
                    ],
                    "markdownDescription": "Names of directories that are not searched for queries, e.g. build output that contains copies of the queries."
                },
                "neojoin.javaPath": {
                    "type": "string",
                    "scope": "machine-overridable",
                    "default": "",
                    "markdownDescription": "Path to the `java` program that runs the language server (Java 17 or later). If empty, the extension uses `bin/java` of the environment variable `JAVA_HOME`, or else `java` from the `PATH`.\n\nExample: `/usr/lib/jvm/java-21/bin/java`"
                },
                "neojoin.plantUmlJarPath": {
                    "type": "string",
                    "scope": "machine-overridable",
                    "default": "",
                    "markdownDescription": "Path to the PlantUML jar (`plantuml-<version>.jar`, download it from the [PlantUML releases](https://github.com/plantuml/plantuml/releases)). It is required for the query visualization, because the language server does not contain PlantUML.\n\nExample: `${userHome}/plantuml.jar`"
                },
                "neojoin.debug": {
                    "type": "boolean",
                    "scope": "machine-overridable",
                    "default": false,
                    "markdownDescription": "Enable debug logging into `neojoin-debug.log`."
                }
            }
        }
    },
    "files": [
        "package.json",
        "LICENSE",
        "readme.md",
        "dist/extension.js",
        "src/language/*",
        "resources/**/*",
        "tools.vitruv.neojoin.frontend.ide.jar"
    ],
    "scripts": {
        "compile": "npm run check-types && node esbuild.cjs",
        "check-types": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write \"**/*.{ts,cjs,mjs}\"",
        "format:check": "prettier --check \"**/*.{ts,cjs,mjs}\"",
        "watch": "node scripts/watch.cjs",
        "bundle:production": "npm run check-types && node esbuild.cjs --production",
        "vscode:prepublish": "npm run bundle:production",
        "package": "vsce package --no-dependencies --out neojoin.vsix"
    },
    "config": {
        "languageServerVersion": "0.1.0-SNAPSHOT"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^20",
        "@types/vscode": "~1.91.0",
        "@vscode/vsce": "^4.1.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1"
    },
    "dependencies": {
        "vscode-languageclient": "^11.0.0"
    }
}
